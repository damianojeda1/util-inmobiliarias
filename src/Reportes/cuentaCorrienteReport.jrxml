	</title>
	<pageHeader>
		<band height="46" splitType="Stretch">
			<staticText>
				<reportElement  x="51" y="2" width="66" height="20"/>
				<textElement verticalAlignment="Middle">
					<font isUnderline="true"/>
				</textElement>
				<text><![CDATA[Fecha desde:]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy">
				<reportElement  x="117" y="2" width="100" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.util.Date"><![CDATA[$P{fecDesde}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement  x="316" y="2" width="62" height="20"/>
				<textElement verticalAlignment="Middle">
