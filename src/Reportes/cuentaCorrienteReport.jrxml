			</staticText>
			<textField pattern="dd/MM/yyyy">
				<reportElement  x="378" y="2" width="100" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.util.Date"><![CDATA[$P{fecHasta}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement  x="409" y="26" width="66" height="20"/>
				<textElement verticalAlignment="Middle">
					<font isUnderline="true"/>
				</textElement>
				<text><![CDATA[Saldo Inicial:]]></text>
			</staticText>
			<textField pattern="¤ #,##0.00">
				<reportElement  x="475" y="26" width="80" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{saldoInicial}]]></textFieldExpression>
