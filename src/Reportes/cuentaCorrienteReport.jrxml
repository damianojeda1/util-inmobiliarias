<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cuentaCorrienteReport" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" >
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1" />
	<parameter name="razonSocial" class="java.lang.String"/>
	<parameter name="fechaEmision" class="java.util.Date"/>
	<parameter name="domicilio" class="java.lang.String"/>
	<parameter name="telefono" class="java.lang.String"/>
	<parameter name="fecDesde" class="java.util.Date"/>
	<parameter name="fecHasta" class="java.util.Date"/>
	<parameter name="saldoInicial" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT fecha_operacion, monto_operacion, descripcion_operacion
FROM sistemadegestion.operacion
INNER JOIN sistemadegestion.cuentacorriente ON id_cuentacorriente_operacion = id_cuentacorriente
INNER JOIN sistemadegestion.persona ON id_persona = id_persona_cuentacorriente
WHERE razonsocial_persona =  $P{razonSocial}
 and fecha_operacion >= $P{fecDesde}  and fecha_operacion <= $P{fecHasta}]]>
	</queryString>
	<field name="fecha_operacion" class="java.sql.Date"/>
	<field name="monto_operacion" class="java.math.BigDecimal"/>
	<field name="descripcion_operacion" class="java.lang.String"/>
	<variable name="monto" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_operacion}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal("0")]]></initialValueExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="114" splitType="Stretch">
			<staticText>
				<reportElement  x="375" y="0" width="90" height="20"/>
				<textElement verticalAlignment="Middle">
					<font isUnderline="true"/>
				</textElement>
				<text><![CDATA[Fecha de Emisión:]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
				<reportElement  x="465" y="0" width="90" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.util.Date"><![CDATA[$P{fechaEmision}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement  x="233" y="45" width="70" height="20"/>
				<textElement verticalAlignment="Middle">
