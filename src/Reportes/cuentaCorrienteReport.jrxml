			<image>
				<reportElement  x="1" y="3" width="230" height="110"/>
				<imageExpression><![CDATA["src\\Recursos\\Imagenes\\deco.jpg"]]></imageExpression>
			</image>
			<staticText>
				<reportElement  x="90" y="-20" width="375" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
