			</staticText>
			<textField>
				<reportElement  x="304" y="45" width="251" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$P{razonSocial}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement  x="233" y="65" width="55" height="20"/>
				<textElement verticalAlignment="Middle">
					<font isUnderline="true"/>
				</textElement>
				<text><![CDATA[Domicilio:]]></text>
			</staticText>
			<textField>
				<reportElement  x="304" y="65" width="251" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$P{domicilio}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement  x="233" y="86" width="55" height="20"/>
				<textElement verticalAlignment="Middle">
					<font isUnderline="true"/>
				</textElement>
				<text><![CDATA[Teléfono:]]></text>
			</staticText>
			<textField>
				<reportElement  x="304" y="85" width="251" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$P{telefono}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement  x="375" y="19" width="180" height="1"/>
			</line>
			<line>
